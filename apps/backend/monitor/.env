# ========== PostgreSQL ==========
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=xiaoer
PG_DB=postgres

# ========== Redis（Bull 队列 + 缓存） ==========
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== Kafka ==========
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=zzx-monitor
KAFKA_GROUP_ID=zzx-consumer

# ========== ClickHouse ==========
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=zzxclickhouse

# ========== JWT ==========
JWT_SECRET=secretKey
JWT_EXPIRES_IN=1d

# ========== SMTP（QQ 邮箱示例） ==========
SMTP_URL=smtps://xxxxx@qq.com:授权码@smtp.qq.com

# ========== 运行环境 ==========
NODE_ENV=development
PORT=8081